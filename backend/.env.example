PORT=8000
# Obavezno: dugačak nasumičan string (npr. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_SECRET=
# Dozvoljeni origin(i) frontenda, odvojeni zarezom
CORS_ORIGIN=http://localhost:5500
# Putanja do SQLite fajla; prazno = backend/data/tokenledger.db
DB_PATH=
# Tajna za šifrovanje provajder ključeva; prazno = koristi se JWT_SECRET
KEY_ENCRYPTION_SECRET=
# Javna adresa backenda; proxyUrl koji vidi frontend je PUBLIC_URL + /api/proxy
PUBLIC_URL=http://localhost:8000
# Upstream adrese proxyja (menjaj samo za testove sa lažnim provajderom)
OPENAI_BASE_URL=https://api.openai.com
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Lozinka demo naloga koje pravi `npm run seed`
SEED_PASSWORD=demo
